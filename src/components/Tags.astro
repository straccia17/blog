---
import type { Collation } from '~/types'

interface Props {
  tags: Collation<'posts'>[]
}

const { tags } = Astro.props
---

<div class="flex flex-wrap gap-2 text-sm">
  {
    tags.map((tag) => (
      <a
        href={tag.url}
        class="tag-pill py-1 px-3 text-accent/90 rounded-2xl transition-colors"
      >
        #{tag.title}
      </a>
    ))
  }
</div>
